{
  "info": {
    "name": "ShopKart API",
    "description": "Complete collection for ShopKart backend API. \n\n**How to use:**\n1. Import this file into Postman.\n2. Run 'Login' request — the JWT token is saved automatically to the `token` collection variable.\n3. All protected routes use `{{token}}` automatically in the Authorization header.\n4. Set `{{productId}}` manually after running 'Create Product' or 'Get All Products'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string",
      "description": "Set this after running 'Create Product' or 'Get All Products'"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "👤 Customers",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Akhila Test\",\n  \"email\": \"akhila@example.com\",\n  \"password\": \"Test@123\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/register",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Auto-save JWT from cookie into collection variable",
                  "const setCookieHeader = pm.response.headers.get('Set-Cookie');",
                  "if (setCookieHeader) {",
                  "    const tokenMatch = setCookieHeader.match(/token=([^;]+)/);",
                  "    if (tokenMatch) {",
                  "        pm.collectionVariables.set('token', tokenMatch[1]);",
                  "        console.log('Token saved to collection variable!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"akhila@example.com\",\n  \"password\": \"Test@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/login",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers/me",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Test@123\",\n  \"newPassword\": \"NewPass@456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "change-password"]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/customers/logout",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "logout"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "📦 Products",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.product) {",
                  "    pm.collectionVariables.set('productId', response.product._id);",
                  "    console.log('Product ID saved:', response.product._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"description\": \"Ergonomic wireless mouse with 3-year battery life.\",\n  \"price\": 1499,\n  \"category\": \"Electronics\",\n  \"image\": \"https://images.unsplash.com/photo-1527864550417-7fd91fc51a46?w=600&h=400&fit=crop\",\n  \"stock\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          },
          "response": []
        },
        {
          "name": "Get All Products",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "search", "value": "", "disabled": true },
                { "key": "category", "value": "", "disabled": true },
                { "key": "sort", "value": "price_asc", "disabled": true }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get All Products (search)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?search=laptop&sort=price_desc",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "search", "value": "laptop" },
                { "key": "sort", "value": "price_desc" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Product By ID",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "❤️ Wishlist",
      "item": [
        {
          "name": "Add to Wishlist",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/wishlist/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist", "{{productId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Wishlist",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/wishlist",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist"]
            }
          },
          "response": []
        },
        {
          "name": "Toggle Wishlist",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/wishlist/{{productId}}/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist", "{{productId}}", "toggle"]
            }
          },
          "response": []
        },
        {
          "name": "Remove from Wishlist",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/wishlist/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["wishlist", "{{productId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "🛒 Cart",
      "item": [
        {
          "name": "Add to Cart",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/cart/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "{{productId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            }
          },
          "response": []
        },
        {
          "name": "Update Cart Quantity",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cart/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "{{productId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Remove from Cart",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/cart/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "{{productId}}"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
